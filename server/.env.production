# Production Environment Configuration for Gymgram
# This file contains the production environment variables
# Replace the placeholder values with your actual production values

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/gymgram

# JWT Secret - CHANGE THIS TO A SECURE RANDOM STRING
JWT_SECRET=your_secure_jwt_secret_key_here_change_this_in_production

# AWS S3 Configuration - These will be provided by Lightsail bucket
AWS_ACCESS_KEY_ID=auto_generated_by_lightsail
AWS_SECRET_ACCESS_KEY=auto_generated_by_lightsail
AWS_REGION=us-east-1
AWS_S3_BUCKET=gymgram-media-bucket

# Server Configuration
PORT=5000
NODE_ENV=production

# Frontend URL (will be replaced with actual instance IP during deployment)
CLIENT_URL=https://INSTANCE_PUBLIC_IP

# Database credentials (will be set during MongoDB setup)
DB_USER=gymgram_user
DB_PASSWORD=CHANGE_ME_secure_password_123
